VITE_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=REPLACE_ME
VITE_COGNITO_DOMAIN=https://REPLACE_ME.auth.us-east-1.amazoncognito.com

# Optional; defaults to the current origin plus /auth/callback and / respectively.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
# Optional; the check-ins API URL (CDK output CheckInsApiUrl). Without it,
# check-ins stay in this browser's local storage.
# VITE_CHECKINS_API_URL=https://abc123.execute-api.eu-central-1.amazonaws.com
