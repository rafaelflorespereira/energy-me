# Copy into the consuming Expo app, not into this library.
# Public configuration only; never add provider secrets or Apple private keys.
EXPO_PUBLIC_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
EXPO_PUBLIC_USER_POOL_CLIENT_ID=<public-app-client-id>
EXPO_PUBLIC_APP_SCHEME=cognitoapp
EXPO_PUBLIC_LOGOUT_URI=cognitoapp://
